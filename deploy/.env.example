# Domain utama. Subdomain yang dibutuhkan (A record -> IP VPS):
#   @, www, api, cdn
DOMAIN=example.com

# Password PostgreSQL. HANYA huruf & angka (tanpa simbol @ : / # ?),
# karena nilai ini ikut disisipkan ke dalam URL DATABASE_URL.
POSTGRES_PASSWORD=

# JWT secret. Generate: openssl rand -hex 32
JWT_EXPIRES_IN=24h
JWT_SECRET=

# Admin awal. Hanya dipakai saat database masih kosong (belum ada user).
# Setelah ada, ganti password lewat menu admin (PUT /api/auth/password).
ADMIN_EMAIL=admin@fasqindo.com
ADMIN_PASSWORD=

# Object storage (MinIO). User: huruf & angka. Password: huruf & angka, min 16 karakter.
# Generate keduanya: openssl rand -hex 16
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=fasqindo
