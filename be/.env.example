APP_ENV=development
APP_PORT=8080

# Postgres runs in docker-compose on host port 5433 (5432 was already taken)
DATABASE_URL=postgres://postgres:password@localhost:5433/fasqindo

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

FRONTEND_URL=http://localhost:3000

# Initial admin account (seeded when the users table is empty)
ADMIN_EMAIL=admin@fasqindo.com
ADMIN_PASSWORD=password

# S3-compatible object storage (MinIO, AWS S3, Cloudflare R2, Tencent COS, ...)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fasqindo
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/fasqindo
